{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offwork-countdown",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": false,
  "keep_vars": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/download/OffWorkCountdown.exe"]
  }
}
